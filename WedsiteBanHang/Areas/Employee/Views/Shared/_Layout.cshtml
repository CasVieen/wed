<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kênh Nhân Viên Vận Hành</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body {
                background-color: #f8fafc;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .sidebar {
                min-height: 100vh;
                background: #334155;
            }

                .sidebar .nav-link {
                    color: #cbd5e1;
                    padding: 12px 20px;
                    border-radius: 6px;
                    margin: 3px 12px;
                    font-weight: 500;
                }

                    .sidebar .nav-link:hover {
                        color: #fff;
                        background: rgba(255,255,255,0.08);
                    }

                    .sidebar .nav-link.active {
                        color: #fff;
                        background: #6366f1;
                    }

            .main-content {
                padding: 25px;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Navigation -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse px-0">
                <div class="d-flex flex-column h-100">
                    <div class="p-4 border-bottom border-secondary text-center">
                        <a asp-area="Employee" asp-controller="Home" asp-action="Index" class="text-decoration-none">
                            <h4 class="text-white fw-bold m-0"><i class="bi bi-person-workspace text-warning me-2"></i>Staff Portal</h4>
                        </a>
                        <small class="text-light opacity-50">Kênh Nhân Viên Vận Hành</small>
                    </div>

                    <ul class="nav nav-pills flex-column mt-3 mb-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-area="Employee" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i> Bảng điều khiển
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderManagement" ? "active" : "")"
                               asp-area="Employee" asp-controller="OrderManagement" asp-action="Index">
                                <i class="bi bi-box-seam me-2"></i> Quản lý Đơn hàng
                            </a>
                        </li>
                    </ul>

                    <div class="p-3 border-top border-secondary">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 btn-sm">
                            <i class="bi bi-shop me-1"></i> Trang Mua Sắm
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-0">
                <nav class="navbar navbar-expand navbar-light bg-white px-4 py-3 border-bottom shadow-sm">
                    <div class="container-fluid p-0">
                        <span class="navbar-brand text-secondary fs-6 fw-bold">
                            <i class="bi bi-headset me-2"></i>HỆ THỐNG XỬ LÝ ĐƠN HÀNG & HỖ TRỢ KHÁCH HÀNG
                        </span>
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="staffUserDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle text-indigo me-1"></i> @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="main-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>