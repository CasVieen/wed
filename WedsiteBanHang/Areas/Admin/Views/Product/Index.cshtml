@model IEnumerable<WedsiteBanHang.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <!-- Header & Nút Thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-0">Danh sách sản phẩm</h2>
            <p class="text-muted mb-0">Quản lý toàn bộ thông tin sản phẩm trong hệ thống</p>
        </div>
        <a asp-area="Admin" asp-controller="Product" asp-action="Add" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
        </a>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Danh mục</th>
                            <th>Mô tả</th>
                            <th class="text-center" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Hình ảnh sản phẩm -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Name" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <img src="https://via.placeholder.com/60x60?text=No+Img" alt="No Image" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                    </td>

                                    <!-- Tên sản phẩm -->
                                    <td class="fw-bold text-dark">@item.Name</td>

                                    <!-- Giá bán -->
                                    <td class="text-danger fw-bold">@item.Price.ToString("c")</td>

                                    <!-- Danh mục -->
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @(item.Category?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>

                                    <!-- Mô tả cắt ngắn -->
                                    <td class="text-muted small">
                                        @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 50)
                                        {
                                            @(item.Description.Substring(0, 50) + "...")
                                        }
                                        else
                                        {
                                            @(item.Description ?? "Chưa có mô tả")
                                        }
                                    </td>

                                    <!-- Nút thao tác khớp chuẩn với Controller (Update, Display, Delete) -->
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có sản phẩm nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>