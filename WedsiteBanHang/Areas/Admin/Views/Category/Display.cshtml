@model WedsiteBanHang.Models.Category

@{
    ViewData["Title"] = "Chi tiết Danh mục";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow border-0">
        <div class="card-header bg-info text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Chi Tiết Danh Mục</h4>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-bold text-secondary">Mã Danh Mục (ID):</dt>
                <dd class="col-sm-8 fw-bold">#@Model?.Id</dd>

                <dt class="col-sm-4 fw-bold text-secondary">Tên Danh Mục:</dt>
                <dd class="col-sm-8 text-primary fw-bold">@Model?.Name</dd>

                <dt class="col-sm-4 fw-bold text-secondary">Mô Tả:</dt>
                <dd class="col-sm-8 text-muted">
                    @(string.IsNullOrEmpty(Model?.Description) ? "Không có mô tả" : Model.Description)
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light border-top p-3 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
            <a asp-action="Update" asp-route-id="@Model?.Id" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>Chỉnh sửa
            </a>
        </div>
    </div>
</div>