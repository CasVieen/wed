@model WedsiteBanHang.Models.Category

@{
    ViewData["Title"] = "Xóa Danh mục";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow border-danger border-1">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác Nhận Xóa Danh Mục</h4>
        </div>
        <div class="card-body p-4">
            <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa danh mục này? Thao tác này không thể hoàn tác!</p>

            <div class="border rounded p-3 bg-light mb-3">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary">Tên Danh Mục:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model?.Name</dd>

                    <dt class="col-sm-4 text-secondary">Mô Tả:</dt>
                    <dd class="col-sm-8 text-muted">@Model?.Description</dd>
                </dl>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Xóa vĩnh viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>