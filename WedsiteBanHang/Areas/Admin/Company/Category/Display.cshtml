@model WedsiteBanHang.Models.Category
@{
    ViewData["Title"] = "Chi tiết Danh mục";
}

<div class="col-md-6 offset-md-3">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold m-0"><i class="bi bi-info-circle text-info me-2"></i>Chi Tiết Danh Mục</h5>
            <span class="badge bg-primary fs-6">ID: @Model.Id</span>
        </div>
        <div class="card-body p-4">
            <div class="mb-3">
                <label class="text-secondary fw-semibold small">TÊN DANH MỤC</label>
                <h4 class="fw-bold text-dark mt-1">@Model.Name</h4>
            </div>

            <hr class="text-muted" />

            <div class="mb-4">
                <label class="text-secondary fw-semibold small">MÔ TẢ</label>
                <p class="text-dark mt-1 fs-6">
                    @(string.IsNullOrEmpty(Model.Description) ? "Chưa có thông tin mô tả cho danh mục này." : Model.Description)
                </p>
            </div>

            <div class="d-flex justify-content-between pt-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <div>
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Xóa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>